+        log(f"[manuals-editions] {fid}: сохранена редакция {saved['revision']} ({len(html)} символов)")
+        return JSONResponse(public(saved, fid), headers=NO_STORE)
+
+    @r.get("/{fid}/history")
+    def history(fid: str, request: Request):
